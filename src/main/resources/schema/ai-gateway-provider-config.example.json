{
  "provider": "OPENAI",
  "model": "gpt-5",
  "url": "https://api.openai.com/v1",
  "auth": {
    "type": "API_KEY",
    "apiKey": "${OPENAI_API_KEY}"
  },
  "request": {
    "temperature": 0.2,
    "max_tokens": 4096,
    "fallbackModel": "gpt-5-mini",
    "response_format": {
      "type": "json_object"
    }
  },
  "guardrails": [
    {
      "id": "prompt-injection",
      "type": "PROMPT_INJECTION",
      "stage": "REQUEST",
      "action": "BLOCK",
      "config": {}
    },
    {
      "id": "response-pii",
      "type": "PII_REDACTION",
      "stage": "RESPONSE",
      "action": "REDACT",
      "config": {}
    }
  ]
}
