{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexparas.com/schemas/ai-gateway/provider-config.schema.json",
  "title": "AI Gateway Redis Model Configuration",
  "description": "The JSON value stored in the Redis model-configuration hash. The Redis hash field is the requested model name and must match model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "model", "auth", "guardrails"],
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["OPENAI", "ANTHROPIC", "BEDROCK", "GOOGLE", "AZURE"]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Must equal the Redis hash field used for this lookup."
    },
    "url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "region": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9-]+$"
    },
    "deployment": {
      "type": ["string", "null"]
    },
    "apiVersion": {
      "type": ["string", "null"]
    },
    "enabled": {
      "type": "boolean",
      "const": true,
      "default": true
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guardrail"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "API_KEY",
            "OAUTH2",
            "AWS_CREDENTIALS",
            "ROLE",
            "WORKLOAD_IDENTITY",
            "AZURE_MANAGED_IDENTITY"
          ]
        },
        "apiKey": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "api_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "token": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "accessKeyId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "access_key_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "secretAccessKey": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "secret_access_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sessionToken": {
          "type": ["string", "null"]
        },
        "roleArn": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "project": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "projectId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "project_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "API_KEY"
              }
            }
          },
          "then": {
            "required": ["apiKey"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ROLE"
              }
            }
          },
          "then": {
            "required": ["roleArn"]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "CHAT",
            "RESPONSES",
            "CONVERSE",
            "GENERATE_CONTENT",
            "EMBEDDINGS",
            "AUDIO",
            "TRANSCRIPTION"
          ]
        },
        "fallbackModel": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "topP": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top_p": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "frequency_penalty": {
          "type": ["number", "null"]
        },
        "presence_penalty": {
          "type": ["number", "null"]
        },
        "max_tokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "max_completion_tokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "top_k": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "stop": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "stop_sequences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "stream": {
          "type": "boolean"
        },
        "response_format": {
          "type": "object",
          "additionalProperties": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "toolConfig": {
          "type": "object",
          "additionalProperties": true
        },
        "extraHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraBody": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "stage", "action"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "PII_REDACTION",
            "PROMPT_INJECTION",
            "TOXICITY",
            "JAILBREAK",
            "CONTENT_SAFETY",
            "DLP",
            "JSON_SCHEMA",
            "CUSTOM"
          ]
        },
        "stage": {
          "type": "string",
          "enum": ["REQUEST", "RESPONSE", "BOTH"]
        },
        "action": {
          "type": "string",
          "enum": ["BLOCK", "REDACT", "WARN", "TRANSFORM"]
        },
        "policyRef": {
          "type": ["string", "null"]
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
